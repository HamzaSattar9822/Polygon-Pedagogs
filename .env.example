PORT=3000
NODE_ENV=development

# Admin login (change before production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
SESSION_SECRET=replace-with-a-long-random-string

# Notification emails (leave blank to log to console only)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Polygon Pedagogues <noreply@polygonpedagogues.co.uk>"
MAIL_TO_GENERAL=support@polygonpedagogues.co.uk
MAIL_TO_REFERRALS=director@polygonpedagogues.co.uk
MAIL_TO_TUTORS=support@polygonpedagogues.co.uk
MAIL_TO_SAFEGUARDING=dsl@polygonpedagogues.co.uk

# Optional: max upload size in MB
MAX_UPLOAD_MB=10
